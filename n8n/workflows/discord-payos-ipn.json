{
  "name": "Discord - PayOS IPN",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payos-ipn",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-ipn",
      "name": "Webhook IPN",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "notesInFlow": true,
      "notes": "Endpoint nhận IPN từ VNPay"
    },
    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst checksumKey = 'YOUR_PAYOS_CHECKSUM_KEY'; // THAY THẾ BẰNG CHECKSUM KEY\n\nconst body = $input.item.json.body;\nconst reqSignature = body.signature;\nconst data = body.data;\n\nconst sortedKeys = Object.keys(data).sort();\nlet signParams = [];\nfor (let k of sortedKeys) {\n    if (data[k] !== undefined && data[k] !== null && data[k] !== \"\") {\n        signParams.push(k + \"=\" + data[k]);\n    }\n}\nconst signData = signParams.join('&');\nconst signature = crypto.createHmac('sha256', checksumKey).update(signData).digest('hex');\n\nconst isValid = (signature === reqSignature);\nconst isSuccess = (body.code === '00' && body.desc === 'success');\nconst orderCode = data.orderCode;\nconst discordUserId = data.description; // Lấy userId từ description\n\nreturn {\n  json: {\n    isValid,\n    isSuccess,\n    orderCode,\n    discordUserId\n  }\n};\n"
      },
      "id": "verify-hash",
      "name": "Verify HMAC-SHA256",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "notesInFlow": true,
      "notes": "BẮT BUỘC: Xác thực chữ ký điện tử từ PayOS để chống giả mạo"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            },
            {
              "value1": "={{ $json.isSuccess }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-valid",
      "name": "Check Valid & Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true\n}",
        "options": {}
      },
      "id": "webhook-response-success",
      "name": "Webhook Response (Success)",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
