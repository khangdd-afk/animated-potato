      "name": "Google Sheets: Get Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst result = [];\nconst now = new Date();\nfor (const item of rows) {\n  const row = item.json;\n  if (row.Status === 'PENDING') {\n    const rowDate = new Date(row.Date);\n    const diffTime = Math.abs(now - rowDate);\n    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); \n    if (diffDays > 3) { // Quá hạn 3 ngày\n      result.push({ json: row });\n    }\n  }\n}\nreturn result;\n"
      },
      "id": "filter-overdue",
      "name": "Filter Overdue (3 days)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "notesInFlow": true,
      "notes": "Lọc các user quá hạn thanh toán 3 ngày"
    },
    {
